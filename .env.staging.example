# Staging-build (npm run build:staging) — zie docs/v2/STAGING.md
# Kopieer naar .env.staging (staat in .gitignore)
# Staging gebruikt het productie-Supabase-project met test-docentaccounts
# (zie docs/v2/STAGING.md §2).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Feedbackformulier: leeg laten op staging, dan komt er geen testmail binnen.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Wie in de docentenomgeving de statistiekknop ziet (terugval zolang 043 niet draait)
VITE_ADMIN_EMAILS=
