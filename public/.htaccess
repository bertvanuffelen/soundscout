<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /teacher serveert zijn eigen HTML met docent-specifieke SEO-meta
  RewriteRule ^teacher/?$ teacher.html [L]

  # Don't rewrite files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching headers ---
<IfModule mod_headers.c>
  # Audio + images: 1 year cache (Vite adds content hashes to filenames)
  <FilesMatch "\.(mp3|jpg|png|svg|webp|woff2?)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # JS + CSS bundles: 1 year cache (Vite hashed filenames)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # HTML: 1 hour cache, always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>

  # --- Content Security Policy (CSP) ---
  # Strict policy to prevent XSS, injection, and unauthorized resource loading
  # Inline styles required for Tailwind CSS (@apply directives)
  Header set Content-Security-Policy "default-src 'self'; \
    script-src 'self'; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
    font-src 'self' https://fonts.gstatic.com; \
    connect-src 'self' https://xpjutrzonnranyqyqfzj.supabase.co https://api.emailjs.com; \
    img-src 'self' data: blob:; \
    media-src 'self' blob:; \
    worker-src 'self' blob:; \
    frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self'; \
    upgrade-insecure-requests"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
