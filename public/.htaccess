<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /teacher serveert zijn eigen HTML met docent-specifieke SEO-meta
  RewriteRule ^teacher/?$ teacher.html [L]

  # /over is de publieke Over/colofon + contactpagina (eigen SEO-meta)
  RewriteRule ^over/?$ over.html [L]

  # Don't rewrite files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching headers ---
<IfModule mod_headers.c>
  # Audio + images: 1 year cache (Vite adds content hashes to filenames)
  <FilesMatch "\.(mp3|jpg|png|svg|webp|woff2?)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # JS + CSS bundles: 1 year cache (Vite hashed filenames)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # HTML: 1 hour cache, always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>

  # --- Content Security Policy (CSP) ---
  # Strict policy to prevent XSS, injection, and unauthorized resource loading
  # Inline styles required for Tailwind CSS (@apply directives)
  #
  # script-src heeft twee toevoegingen, allebei nodig voor de audio-engine:
  #
  # blob:              -- voor AudioWorklets. Onze eigen DSP-module (limiter +
  #                       capture, AudioService.buildDspWorkletCode) en
  #                       signalsmith-stretch registreren hun worklet vanaf een
  #                       blob-URL. Chrome handhaaft worklet-modules onder
  #                       script-src; er is geen smallere directive.
  # 'wasm-unsafe-eval' -- signalsmith-stretch is WASM. Zonder deze sleutel
  #                       weigert de browser WebAssembly.instantiate. BEWUST
  #                       NIET 'unsafe-eval': die zou ook echte eval()
  #                       toestaan. 'wasm-unsafe-eval' staat uitsluitend
  #                       WebAssembly toe en is daarmee veel smaller.
  #
  # Ontbreekt een van beide, dan valt de pitch-bake terug op Tone.PitchShift
  # (de bewezen bron van de export-glitch, zie
  # docs/audio/ONDERZOEK-EXPORT-EFFECTGLITCH.md §15), draait de app live zonder
  # master-limiter en faalt het realtime-opname-vangnet.
  # NIET weghalen zonder de worklets eerst statisch te hosten -- signalsmith
  # levert daar geen bestand voor.
  Header set Content-Security-Policy "default-src 'self'; \
    script-src 'self' blob: 'wasm-unsafe-eval'; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
    font-src 'self' https://fonts.gstatic.com; \
    connect-src 'self' blob: https://xpjutrzonnranyqyqfzj.supabase.co https://api.emailjs.com; \
    img-src 'self' data: blob: https://img.youtube.com; \
    media-src 'self' blob:; \
    worker-src 'self' blob:; \
    frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self'; \
    upgrade-insecure-requests"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
