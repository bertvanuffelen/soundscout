<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /teacher serveert zijn eigen HTML met docent-specifieke SEO-meta
  RewriteRule ^teacher/?$ teacher.html [L]

  # /over is de publieke Over/colofon + contactpagina (eigen SEO-meta)
  RewriteRule ^over/?$ over.html [L]

  # Don't rewrite files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite everything else to index.html.
  # Sinds V2 Fase 2 heeft elk scherm een eigen pad (/kaart, /studio, /podium,
  # /docent, /gedeeld/<code>, /album/<code>, ...): die bestaan niet als bestand
  # en komen dus hier uit, waarna de router in de app het scherm kiest.
  # Bestaande bestanden en mappen (/assets, /audio, /images, /fonts, /les/<key>/,
  # /privacy/, /animaties/) vallen onder de twee voorwaarden hierboven en worden
  # NIET herschreven. Kies voor een nieuw app-pad nooit een naam die ook een map
  # of bestand in public/ is (bewaakt door src/router/__tests__/paths.test.ts).
  # Volledige tabel: docs/v2/URL-CONTRACT.md.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching headers ---
<IfModule mod_headers.c>
  # Audio + images: 1 year cache (Vite adds content hashes to filenames)
  <FilesMatch "\.(mp3|jpg|png|svg|webp|woff2?)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # JS + CSS bundles: 1 year cache (Vite hashed filenames)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # HTML: altijd eerst bij de server navragen (304 als er niets veranderd is).
  # Was 1 uur. Sinds de service worker (V2 Fase 2) bepaalt index.html welke
  # versie van de app start; een uur oude kopie in de browsercache zou een
  # update of de noodrem (docs/v2/OFFLINE.md §6) een uur vertragen.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Service worker: NOOIT in de browsercache. Dit blok moet NA de regel voor
  # .js staan, anders krijgt sw.js "1 jaar, immutable" en ziet een apparaat
  # een nieuwe versie (of de noodrem) niet. Zie docs/v2/OFFLINE.md.
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # Web-app-manifest: kort bewaren, zodat een nieuw icoon of een nieuwe naam
  # zonder omweg doorkomt.
  <Files "manifest.json">
    Header set Cache-Control "no-cache"
  </Files>

  # --- Content Security Policy (CSP) ---
  # Strict policy to prevent XSS, injection, and unauthorized resource loading
  # Inline styles required for Tailwind CSS (@apply directives)
  #
  # script-src heeft twee toevoegingen, allebei nodig voor de audio-engine:
  #
  # blob:              -- voor AudioWorklets. Onze eigen DSP-module (limiter +
  #                       capture, AudioService.buildDspWorkletCode) en
  #                       signalsmith-stretch registreren hun worklet vanaf een
  #                       blob-URL. Chrome handhaaft worklet-modules onder
  #                       script-src; er is geen smallere directive.
  # 'wasm-unsafe-eval' -- signalsmith-stretch is WASM. Zonder deze sleutel
  #                       weigert de browser WebAssembly.instantiate. BEWUST
  #                       NIET 'unsafe-eval': die zou ook echte eval()
  #                       toestaan. 'wasm-unsafe-eval' staat uitsluitend
  #                       WebAssembly toe en is daarmee veel smaller.
  #
  # Ontbreekt een van beide, dan valt de pitch-bake terug op Tone.PitchShift
  # (de bewezen bron van de export-glitch, zie
  # docs/audio/ONDERZOEK-EXPORT-EFFECTGLITCH.md §15), draait de app live zonder
  # master-limiter en faalt het realtime-opname-vangnet.
  # NIET weghalen zonder de worklets eerst statisch te hosten -- signalsmith
  # levert daar geen bestand voor.
  Header set Content-Security-Policy "default-src 'self'; \
    script-src 'self' blob: 'wasm-unsafe-eval'; \
    style-src 'self' 'unsafe-inline'; \
    font-src 'self'; \
    connect-src 'self' blob: https://xpjutrzonnranyqyqfzj.supabase.co https://api.emailjs.com; \
    img-src 'self' data: blob: https://img.youtube.com; \
    media-src 'self' blob:; \
    worker-src 'self' blob:; \
    frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self'; \
    upgrade-insecure-requests"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
