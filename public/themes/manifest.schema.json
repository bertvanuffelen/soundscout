{
  "$id": "https://soundscout.nl/themes/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assetBase": {
      "minLength": 1,
      "type": "string"
    },
    "colors": {
      "properties": {
        "accent": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "mapBackground": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "primary": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "isPublic": {
      "type": "boolean"
    },
    "locations": {
      "items": {
        "properties": {
          "ambient": {
            "minLength": 1,
            "type": "string"
          },
          "hotspots": {
            "items": {
              "properties": {
                "id": {
                  "pattern": "^[a-z0-9][a-z0-9_-]*$",
                  "type": "string"
                },
                "radius": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "sampleId": {
                  "pattern": "^[a-z0-9][a-z0-9_-]*$",
                  "type": "string"
                },
                "visualHint": {
                  "enum": [
                    "glow",
                    "pulse",
                    "none"
                  ],
                  "type": "string"
                },
                "x": {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                "y": {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "id",
                "x",
                "y",
                "sampleId",
                "visualHint"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "image": {
            "minLength": 1,
            "type": "string"
          },
          "textKeys": {
            "properties": {
              "description": {
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "description"
            ],
            "type": "object"
          },
          "unlocked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "image",
          "hotspots"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "map": {
      "properties": {
        "image": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "properties": {
            "nl": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "nl"
          ],
          "type": "object"
        },
        "positions": {
          "items": {
            "properties": {
              "icon": {
                "minLength": 1,
                "type": "string"
              },
              "locationId": {
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "type": "string"
              },
              "size": {
                "enum": [
                  "sm",
                  "md",
                  "lg"
                ],
                "type": "string"
              },
              "x": {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "locationId",
              "x",
              "y"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "image",
        "positions"
      ],
      "type": "object"
    },
    "samples": {
      "items": {
        "properties": {
          "color": {
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          "duration": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "file": {
            "minLength": 1,
            "type": "string"
          },
          "icon": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "sfx",
              "loop"
            ],
            "type": "string"
          },
          "locationId": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "textKey": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "locationId",
          "file",
          "duration",
          "icon",
          "color"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "season": {
      "properties": {
        "from": {
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "type": "string"
        },
        "until": {
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "type": "string"
        }
      },
      "required": [
        "from",
        "until"
      ],
      "type": "object"
    },
    "sort": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ],
      "type": "string"
    },
    "texts": {
      "additionalProperties": {
        "properties": {
          "description": {
            "type": "string"
          },
          "locations": {
            "additionalProperties": {
              "properties": {
                "description": {
                  "type": "string"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "samples": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "properties": {
        "nl": {
          "properties": {
            "description": {
              "type": "string"
            },
            "locations": {
              "additionalProperties": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "samples": {
              "additionalProperties": {
                "minLength": 1,
                "type": "string"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "name",
            "description",
            "locations",
            "samples"
          ],
          "type": "object"
        }
      },
      "required": [
        "nl"
      ],
      "type": "object"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "isPublic",
    "map",
    "locations",
    "samples",
    "texts"
  ],
  "title": "SoundScout theme manifest",
  "type": "object"
}
