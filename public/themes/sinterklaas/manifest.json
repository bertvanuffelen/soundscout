          "name": "The Steamboat"
        },
        "dak": {
          "description": "The horse steps across the roofs by moonlight",
          "name": "On the Rooftops"
        },
        "pakjeskamer": {
          "description": "Where every present gets wrapped",
          "name": "The Present Room"
        },
        "bakkerij": {
          "description": "The helper robots bake pepernoten",
          "name": "The Pepernoten Bakery"
        },
        "huiskamer": {
          "description": "Present evening: the shoe is ready",
          "name": "The Living Room"
        }
