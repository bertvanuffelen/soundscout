# SoundScout Environment Variables
# Kopieer dit bestand naar .env.local voor lokale development
# of naar .env.production voor productie builds.
#
# .env.local       → lokaal (npm run dev)
# .env.production  → productie (npm run build)
#
# Vite laadt automatisch het juiste bestand.
# Zie: https://vite.dev/guide/env-and-mode

# --- Supabase ---
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-key

# --- EmailJS (Feedback/Emergency systeem) ---
# Dashboard: https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=service_xxx
VITE_EMAILJS_TEMPLATE_ID=template_xxx
VITE_EMAILJS_PUBLIC_KEY=xxx

# --- App Settings ---
# Optioneel: stel de app URL in voor Open Graph meta tags
VITE_APP_URL=https://soundscout.nl
